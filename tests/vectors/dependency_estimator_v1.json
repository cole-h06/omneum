{
  "estimator_version": "dependency-estimator-v1",
  "signal_order": [
    "provenance",
    "lineage",
    "ownership",
    "temporal",
    "structural"
  ],
  "output_comparison": {
    "mode": "exact_binary64",
    "tolerance": null,
    "description": "Convert JSON numbers to IEEE-754 binary64 and compare outputs exactly after using the specified operation and accumulation order."
  },
  "cases": [
    {
      "name": "provenance_jaccard",
      "operation": "provenance",
      "source_a_ids": ["p1", "p2"],
      "source_b_ids": ["p2", "p3"],
      "expected_score": 0.3333333333333333
    },
    {
      "name": "provenance_observed_empty",
      "operation": "provenance",
      "source_a_ids": [],
      "source_b_ids": [],
      "expected_score": 0.0,
      "expected_observable": 1.0
    },
    {
      "name": "lineage_direction",
      "operation": "lineage",
      "a_to_b": 1.0,
      "b_to_a": 0.0,
      "expected_score": 1.0,
      "expected_observable_with_missing_reverse_capture": 1.0
    },
    {
      "name": "lineage_cited_source",
      "operation": "lineage_evidence",

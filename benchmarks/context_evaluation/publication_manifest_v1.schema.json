{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication evidence contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "original_dashboard_sha256",
    "configuration_sha256",
    "publication_tables_sha256",
    "representations",
    "historical_sources",
    "artifacts",
    "lineage_audit"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "original_dashboard_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publication_tables_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "representations": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "original_sha256",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^benchmarks/context_evaluation/[^\\n]+$"
          },
          "original_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "historical_sources": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^benchmarks/context_evaluation/[^\\n]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "lineage_audit": {
      "type": "object"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previous_contract_sha256",
          "changes"
        ],
        "properties": {
          "previous_contract_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "changes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "previous_sha256",
                "sha256",
                "reason"
              ],
              "properties": {
                "previous_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}

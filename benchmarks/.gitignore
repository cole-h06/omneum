# Unreviewed offline analysis output; reviewed evidence remains in analysis/.
context_selection/synthetic/reproductions/

# Locks coordinate local execution; completed evidence does not need them.
context_selection/synthetic/results/**/.run.lock
__pycache__/
*.py[cod]
.DS_Store

# Interrupted atomic writes can be recovery evidence: inspect before deleting.
context_selection/synthetic/results/**/.results-*

# Rebuildable SQLite coordination cache; keep databases and WAL receipt data reviewable.
context_selection/synthetic/results/**/local/omneum.db-shm

                    ],
                    "minimum": 0
                  },
                  "selection_p95_seconds": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "end_to_end_p50_seconds": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "end_to_end_p95_seconds": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "latency_basis": {
                    "type": "string"
                  },
                  "api_tokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "estimated_api_cost_usd": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            },
            "frontier_llm_judges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "configuration_id",
                  "label",
                  "source_run",
                  "attempts",
                  "accuracy",
                  "accuracy_basis",
                  "precision",
                  "recall",
                  "selection_scored_attempts",
                  "selection_p50_seconds",
                  "selection_p95_seconds",
                  "end_to_end_p50_seconds",
                  "end_to_end_p95_seconds",
                  "latency_basis",
                  "api_tokens",
                  "estimated_api_cost_usd"
                ],
                "properties": {
                  "configuration_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "source_run": {
                    "type": "string"
                  },
                  "attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "accuracy": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "accuracy_basis": {
                    "type": "string"
                  },
                  "precision": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "recall": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "selection_scored_attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "selection_p50_seconds": {
                    "type": [

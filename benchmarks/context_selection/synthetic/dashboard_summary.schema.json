      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "scope",
        "original_dashboard_sha256",
        "verification_limit"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "path": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "original_dashboard_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification_limit": {
          "type": "string"
        }

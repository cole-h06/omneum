  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omneum benchmark dashboard summary v2.0.0",
  "description": "Schema for published benchmark configurations, measurements, and provenance.",
  "$defs": {
    "family": {
      "enum": [
        "semantic_reranker",
        "frontier_llm_judge",
        "standalone_omneum",
        "semantic_retriever"
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "rate"
      ],
      "properties": {
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "total",
        "reasoning"
      ],
      "properties": {
        "input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "percentiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50",
        "p95"
      ],
      "properties": {
        "p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "method_families",
        "configuration_kind",
        "execution_shape",
        "baseline_configuration_id",
        "augmentation_target",
        "components",
        "selector_inputs",
        "attempts",
        "case_count",
        "trials_per_case",
        "outcomes",
        "selection",
        "latency_seconds",
        "api_tokens",
        "cost_usd",
        "local_reranker_tokens",
        "run_id",
        "method_id",
        "accuracy_basis",
        "recorded_answer_scores",
        "measurement_coverage",
        "comparison_scope",
        "lineage",
        "publication_status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "method_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/family"
          }
        },
        "configuration_kind": {
          "enum": [
            "baseline",
            "omneum_augmented"
          ]
        },
        "execution_shape": {
          "enum": [
            "pipeline",
            "standalone"
          ]
        },
        "baseline_configuration_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "augmentation_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "method",
              "model"
            ],
            "properties": {
              "role": {
                "enum": [
                  "reranker",
                  "context_selector",
                  "answer_generator"
                ]
              },
              "method": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            }
          }
        },
        "selector_inputs": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "trials_per_case": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete_answer_accuracy",
            "incorrect",
            "incomplete",
            "generator_refusal",
            "unanswered",
            "unadjudicated",
            "other_failure"
          ],
          "properties": {
            "complete_answer_accuracy": {
              "$ref": "#/$defs/outcome"
            },
            "incorrect": {
              "$ref": "#/$defs/outcome"
            },
            "incomplete": {
              "$ref": "#/$defs/outcome"
            },
            "generator_refusal": {
              "$ref": "#/$defs/outcome"
            },
            "unanswered": {
              "$ref": "#/$defs/outcome"
            },
            "unadjudicated": {
              "$ref": "#/$defs/outcome"
            },
            "other_failure": {
              "$ref": "#/$defs/outcome"
            }
          }
        },
        "selection": {
          "type": "object",

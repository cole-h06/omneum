{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "benchmark_id",
    "measurement_date",
    "selector_version",
    "supported_method_families",
    "definitions",
    "pairing",
    "pricing",
    "source_file_sha256",
    "implementation",
    "limitations",
    "unmeasured_configurations",
    "configurations",
    "units",
    "runs",
    "analyses",
    "leaderboards",
    "comparability",
    "publication",
    "lineage_audit",
    "publication_contract"
  ],
  "properties": {
    "$schema": {
      "const": "dashboard_summary.schema.json"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "benchmark_id": {
      "type": "string"
    },
    "measurement_date": {
      "type": "string",
      "format": "date"
    },
    "selector_version": {
      "type": "string"
    },
    "supported_method_families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomes",
        "selection",
        "latency",
        "tokens",
        "cost",
        "configuration"
      ],
      "properties": {
        "outcomes": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "latency": {
          "type": "string"
        },
        "tokens": {
          "type": "string"
        },
        "cost": {
          "type": "string"
        },
        "configuration": {
          "type": "string"
        }
      }
    },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods",
        "pair_count",
        "keys",
        "identical_bge_shortlists",
        "identical_context_budgets",
        "shared_generator"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "pair_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identical_bge_shortlists": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "identical_context_budgets": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "shared_generator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pricing": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "date_checked",
        "usd_per_million",
        "basis"
      ],
      "properties": {
        "date_checked": {
          "type": "string"
        },
        "usd_per_million": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "basis": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_file_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unmeasured_configurations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/configuration"
          },
          {
            "properties": {
              "publication_status": {
                "const": "authoritative"
              }
            }
          }
        ]
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rates",
        "latency",
        "api_tokens",
        "cost"
      ],
      "properties": {
        "rates": {
          "const": "fraction"
        },
        "latency": {
          "const": "seconds"
        },
        "api_tokens": {
          "const": "provider_tokens"
        },
        "cost": {
          "const": "USD"
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "records",
          "configuration_ids",
          "issues",
          "verification",
          "publication_status",
          "publication_reason",
          "source_paths",
          "git",
          "versions",
          "implementation_lineage",
          "recorded_evaluation_metrics"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "partial",
              "quarantined",
              "diagnostic_only"
            ]
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "configuration_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "object"
          },
          "dataset_sha256": {
            "type": "string"
          },
          "implementation": {
            "type": [
              "string",
              "null"
            ]
          },
          "trials_per_case": {
            "type": "integer",
            "minimum": 0
          },
          "pairing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_trial_pairs",
              "shared_shortlist_verified",
              "context_budgets_verified",
              "generator_model_verified"
            ],
            "properties": {
              "case_trial_pairs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "shared_shortlist_verified": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "context_budgets_verified": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "generator_model_verified": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "timestamp_utc": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_status": {
            "enum": [
              "authoritative",
              "historical",
              "superseded",
              "diagnostic",
              "partial",
              "quarantined"
            ]
          },
          "publication_reason": {
            "type": "string"
          },
          "source_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "git": {
            "type": [
              "object",
              "null"
            ]
          },
          "recorded_evaluation_metrics": {
            "type": [
              "object",
              "null"
            ]
          },
          "versions": {
            "type": [
              "object",
              "null"
            ]
          },
          "implementation_lineage": {
            "type": [
              "object",
              "null"
            ]
          },
          "dependency_estimator": {
            "type": [
              "object",
              "null"
            ]
          },
          "models": {
            "type": "object"
          },
          "method_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "case_count": {
            "type": "integer",
            "minimum": 0
          },
          "component_manifests": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "trial_run",
          "files",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "trial_run": {
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "leaderboards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_rerankers",
        "frontier_llm_judges"
      ],
      "properties": {
        "semantic_rerankers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configuration_ids",
            "reference_configuration_ids",
            "comparator_configuration_ids"
          ],
          "properties": {
            "configuration_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reference_configuration_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "comparator_configuration_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "frontier_llm_judges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configuration_ids",
            "reference_configuration_ids",
            "comparator_configuration_ids"
          ],
          "properties": {
            "configuration_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reference_configuration_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "comparator_configuration_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "cross_run_blockers"
      ],
      "properties": {
        "policy": {
          "type": "string"
        },
        "cross_run_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_scope",
        "selection_policy",
        "pairs",
        "tables",
        "unverified_claims"
      ],
      "properties": {
        "authority_scope": {
          "type": "string"
        },
        "selection_policy": {
          "type": "string"
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "configuration_ids",
              "family",
              "reason",
              "evidence_paths"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              },
              "configuration_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "family": {
                "enum": [
                  "semantic_rerankers",
                  "frontier_llm_judges"
                ]
              },
              "reason": {
                "type": "string"
              },
              "evidence_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_rerankers",
            "frontier_llm_judges"
          ],
          "properties": {
            "semantic_rerankers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "configuration_id",
                  "label",
                  "source_run",
                  "attempts",
                  "accuracy",
                  "accuracy_basis",
                  "precision",
                  "recall",
                  "selection_scored_attempts",
                  "selection_p50_seconds",
                  "selection_p95_seconds",
                  "end_to_end_p50_seconds",
                  "end_to_end_p95_seconds",
                  "latency_basis",
                  "api_tokens",
                  "estimated_api_cost_usd"
                ],
                "properties": {
                  "configuration_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "source_run": {
                    "type": "string"
                  },
                  "attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "accuracy": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "accuracy_basis": {
                    "type": "string"
                  },
                  "precision": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "recall": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "selection_scored_attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "selection_p50_seconds": {
                    "type": [
                      "number",

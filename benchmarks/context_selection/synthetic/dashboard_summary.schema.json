    "lineage_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_snapshots",
        "events",
        "tied_diagnostic",
        "uncertainty"
      ],
      "properties": {
        "git_snapshots": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tied_diagnostic": {
          "type": "object"
        },
        "uncertainty": {
          "type": "string"
        }
